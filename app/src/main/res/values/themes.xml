<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Cesba" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/cesba_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/soft_blue</item>
        <item name="colorOnPrimaryContainer">@color/cesba_blue</item>
        <item name="colorSecondary">@color/cesba_orange</item>
        <item name="colorOnSecondary">@color/ink</item>
        <item name="colorSurface">@color/paper</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="materialButtonStyle">@style/Widget.Cesba.Button</item>
        <item name="textInputStyle">@style/Widget.Cesba.Input</item>
    </style>
    <style name="Widget.Cesba.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">28dp</item>
        <item name="android:minHeight">58dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.Cesba.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">20dp</item>
        <item name="boxCornerRadiusTopEnd">20dp</item>
        <item name="boxCornerRadiusBottomStart">20dp</item>
        <item name="boxCornerRadiusBottomEnd">20dp</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="errorEnabled">true</item>
        <item name="endIconMode">custom</item>
        <item name="endIconDrawable">@drawable/ic_check</item>
        <item name="endIconTint">@color/valid</item>
        <item name="endIconCheckable">false</item>
    </style>
    <style name="Widget.Cesba.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">20dp</item>
        <item name="boxCornerRadiusTopEnd">20dp</item>
        <item name="boxCornerRadiusBottomStart">20dp</item>
        <item name="boxCornerRadiusBottomEnd">20dp</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="errorEnabled">true</item>
    </style>
    <style name="Text.Cesba.Title" parent="">
        <item name="android:textSize">38sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">-0.035</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:lineSpacingExtra">-2dp</item>
    </style>
    <style name="Text.Cesba.Label" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/muted</item>
    </style>
    <style name="Shape.Cesba.Photo" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
</resources>
