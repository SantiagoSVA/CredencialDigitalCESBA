<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"
    android:background="@color/paper" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView style="@style/Text.Cesba.Label" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/credential_label"/>
        <TextView style="@style/Text.Cesba.Title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/credential_title" android:layout_marginTop="18dp"/>
        <Space android:layout_width="1dp" android:layout_height="48dp" android:layout_weight="1"/>
        <mx.edu.cesba.credencial.ui.credential.CardStageView android:id="@+id/stage"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:clipChildren="false" android:clipToPadding="false">
            <com.google.android.material.card.MaterialCardView android:id="@+id/card"
                android:layout_width="640dp" android:layout_height="404dp" android:clickable="true" android:focusable="true"
                android:contentDescription="@string/flip_accessibility"
                app:cardCornerRadius="28dp" app:cardElevation="4dp" app:strokeWidth="1dp"
                app:strokeColor="#D8DBDF" app:cardBackgroundColor="@color/white">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                    <include android:id="@+id/front" layout="@layout/view_credential_front"/>
                    <include android:id="@+id/back" layout="@layout/view_credential_back" android:visibility="gone"/>
                    <mx.edu.cesba.credencial.ui.credential.SheenView android:id="@+id/sheen"
                        android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no"/>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </mx.edu.cesba.credencial.ui.credential.CardStageView>
        <TextView android:id="@+id/faceLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/credential_front" android:gravity="center" android:textSize="13sp"
            android:textColor="@color/cesba_blue" android:layout_marginTop="28dp" android:accessibilityLiveRegion="polite"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/credential_hint" android:gravity="center" android:textSize="14sp"
            android:textColor="@color/muted" android:layout_marginTop="10dp"/>
        <Space android:layout_width="1dp" android:layout_height="48dp" android:layout_weight="1"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/motto" android:textColor="@color/muted" android:textSize="14sp" android:layout_marginTop="20dp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
